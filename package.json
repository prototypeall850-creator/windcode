{
  "name": "windcode",
  "version": "0.1.0",
  "description": "Agentic coding CLI — reads your code, edits it, runs commands, and asks when unsure.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "windcode": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding",
    "termux"
  ],
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/openai-compatible": "^1.0.0",
    "ai": "^5.0.0",
    "commander": "^14.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
